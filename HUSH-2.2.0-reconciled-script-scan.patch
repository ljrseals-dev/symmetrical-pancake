+bool ident(char c) { return std::isalnum(static_cast<unsigned char>(c)) || c == '_'; }
+std::string lower(std::string s) { for (auto& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c))); return s; }
+bool ends_with(const std::string& s, const std::string& e) { return s.size() >= e.size() && s.compare(s.size() - e.size(), e.size(), e) == 0; }
+
+unsigned lang_bit(const std::string& l) {
+  static const std::map<std::string, unsigned> m = {{"python", PY}, {"lua", LUA}, {"eel", EEL}, {"jsfx", JSFX}, {"shell", SH}, {"batch", BAT},
+    {"powershell", PS}, {"javascript", JS}, {"c/c++", CC}, {"reaper-project", RPP}, {"config", CFG}, {"text", OTHER}, {"reaper-actions", KB}};
+  auto it = m.find(l); return it == m.end() ? OTHER : it->second;
+}
+std::string trim(const std::string& s) {
+  std::size_t a = 0, b = s.size();
+  while (a < b && std::isspace(static_cast<unsigned char>(s[a]))) ++a;
+  while (b > a && std::isspace(static_cast<unsigned char>(s[b - 1]))) --b;
+  return s.substr(a, b - a);
+}
+std::string clip(const std::string& s, std::size_t n = 120) {
+  std::string t = trim(s);
+  if (t.size() > n) t = t.substr(0, n) + "...";
+  for (auto& c : t) if (static_cast<unsigned char>(c) < 32 && c != '\t') c = ' ';
+  return t;
+}
+// Splits a line into code and comment parts (best effort; tracks block comments and triple-quoted strings).
+struct LineState { bool block_comment = false; bool triple = false; char triple_q = 0; bool lua_block = false; };
+void split_comment(const std::string& line, unsigned lang, LineState& st, std::string& code, std::string& comment) {
+  code.clear(); comment.clear();
+  const bool hash_c = lang & (PY | SH | PS | CFG | OTHER);
+  const bool slash_c = lang & (JS | CC | EEL | JSFX);
+  const bool dash_c = lang & LUA;
+  char q = 0;
+  for (std::size_t i = 0; i < line.size(); ++i) {
+    char c = line[i];
+    if (st.block_comment) { comment.push_back(c); if (c == '*' && i + 1 < line.size() && line[i + 1] == '/') { st.block_comment = false; comment.push_back('/'); ++i; } continue; }
+    if (st.lua_block) { comment.push_back(c); if (c == ']' && i + 1 < line.size() && line[i + 1] == ']') { st.lua_block = false; comment.push_back(']'); ++i; } continue; }
+    if (st.triple) {   // inside a Python triple-quoted string: treat as comment text
+      comment.push_back(c);
+      if (c == st.triple_q && i + 2 < line.size() + 0 && line.compare(i, 3, std::string(3, st.triple_q)) == 0) { st.triple = false; comment += std::string(2, st.triple_q); i += 2; }
+      continue;
+    }
+    if (q) { code.push_back(c); if (c == '\\' && i + 1 < line.size()) { code.push_back(line[++i]); } else if (c == q) q = 0; continue; }
+    if ((lang & PY) && (c == '"' || c == '\'') && line.compare(i, 3, std::string(3, c)) == 0) { st.triple = true; st.triple_q = c; i += 2; continue; }
+    if (c == '"' || c == '\'') { q = c; code.push_back(c); continue; }
+    if (slash_c && c == '/' && i + 1 < line.size() && line[i + 1] == '/') { comment = line.substr(i); return; }
+    if (slash_c && c == '/' && i + 1 < line.size() && line[i + 1] == '*') { st.block_comment = true; comment.push_back('/'); continue; }
+    if (dash_c && c == '-' && i + 1 < line.size() && line[i + 1] == '-') {
+      if (line.compare(i, 4, "--[[") == 0) { st.lua_block = true; comment = line.substr(i); return; }
+      comment = line.substr(i); return;
+    }
+    if (hash_c && c == '#') { comment = line.substr(i); return; }
+    if ((lang & PS) && c == '<' && line.compare(i, 2, "<#") == 0) { comment = line.substr(i); return; }
+    code.push_back(c);
+  }
+  if (lang & BAT) { std::string t = lower(trim(code)); if (t.rfind("rem ", 0) == 0 || t.rfind("::", 0) == 0) { comment = code; code.clear(); } }
+}
+bool has_write_mode(const std::string& after_open) {
+  const std::size_t end = std::min<std::size_t>(after_open.size(), 120);
+  for (std::size_t i = 0; i + 2 < end; ++i) {
+    char q = after_open[i];
+    if (q != '"' && q != '\'') continue;
+    std::size_t j = i + 1;
+    if (j < end && (after_open[j] == 'w' || after_open[j] == 'a' || after_open[j] == 'x')) {
+      ++j; while (j < end && (after_open[j] == '+' || after_open[j] == 'b' || after_open[j] == 't')) ++j;
+      if (j < end && after_open[j] == q) return true;
+    }
+  }
+  return false;
+}
+bool is_local_host(const std::string& h) {
+  return h == "localhost" || h == "::1" || h == "[::1]" || h.rfind("127.", 0) == 0 || h == "0.0.0.0";
+}
+bool parse_ipv4(const std::string& h) {
+  int parts = 0; std::size_t i = 0;
+  while (i < h.size()) {
+    std::size_t j = i; int v = 0;
+    while (j < h.size() && std::isdigit(static_cast<unsigned char>(h[j]))) { v = v * 10 + (h[j] - '0'); if (v > 255) return false; ++j; }
+    if (j == i) return false;
+    ++parts; if (j == h.size()) break;
+    if (h[j] != '.') return false;
+    i = j + 1;
+  }
+  return parts == 4;
+}
+bool host_allowed(const std::string& host, const std::vector<std::string>& allow) {
+  for (auto a : allow) { a = lower(a); if (host == a || (host.size() > a.size() && ends_with(host, "." + a))) return true; }
+  return false;
+}
+bool b64ish(char c) { return std::isalnum(static_cast<unsigned char>(c)) || c == '+' || c == '/' || c == '='; }
+bool all_b64(const std::string& s) { if (s.empty()) return false; for (char c : s) if (!b64ish(c)) return false; return true; }
