@@ -0,0 +1,578 @@
+#include "script_scan.hpp"
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <set>
+#include <sstream>
+#include "clipboard.hpp"
+#include "hash.hpp"
+namespace fk::scan {
+namespace fs = std::filesystem;
+const char* severity_name(Severity s) {
+  switch (s) { case Severity::Info: return "info"; case Severity::Low: return "low"; case Severity::Medium: return "medium";
+               case Severity::High: return "high"; case Severity::Critical: return "critical"; }
+  return "info";
+}
+namespace {
+enum Lang : unsigned { PY = 1, LUA = 2, EEL = 4, JSFX = 8, SH = 16, BAT = 32, PS = 64, JS = 128, CC = 256, RPP = 512, CFG = 1024, OTHER = 2048, KB = 4096 };
+constexpr unsigned ALL = 0xFFFF, CODE = PY | LUA | EEL | JSFX | SH | BAT | PS | JS | CC;
+constexpr unsigned LUALIKE = LUA | EEL | PY;      // REAPER scripting languages
+constexpr unsigned SHELLISH = SH | BAT | PS;
+enum Flag : unsigned { NONE = 0, NOT_AFTER_DOT = 1, NO_BOUNDARY = 2 };   // NO_BOUNDARY: also match inside RPR_ExecProcess-style names
+struct Rule {
+  const char* id; unsigned langs; const char* needle; unsigned flags; Severity sev; const char* topic; const char* category;
+  const char* title; const char* why; double conf, fp;
+};
+using S = Severity;
+const Rule kRules[] = {
+  // ---- process execution ----
+  {"py-subprocess", PY, "subprocess.", NONE, S::Medium, "process_exec", "backdoor", "subprocess use", "runs external programs; check the command line and who controls it", .6, .4},
+  {"py-os-system", PY, "os.system(", NONE, S::High, "process_exec", "backdoor", "os.system call", "runs a shell command", .8, .25},
+  {"py-os-popen", PY, "os.popen(", NONE, S::High, "process_exec", "backdoor", "os.popen call", "runs a shell command and reads its output", .8, .25},
+  {"py-os-exec", PY, "os.exec", NONE, S::High, "process_exec", "backdoor", "os.exec* call", "replaces the process with another program", .8, .25},
+  {"py-os-spawn", PY, "os.spawn", NONE, S::Medium, "process_exec", "backdoor", "os.spawn* call", "starts another process", .7, .3},
+  {"py-pty-spawn", PY, "pty.spawn", NONE, S::High, "process_exec", "backdoor", "pty.spawn call", "typical of reverse-shell code", .8, .2},
