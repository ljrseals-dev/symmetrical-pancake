+std::size_t Report::count(Severity s) const { std::size_t n = 0; for (auto& f : findings) if (f.severity == s) ++n; return n; }
+Severity Report::worst() const { Severity w = Severity::Info; for (auto& f : findings) if (f.severity > w) w = f.severity; return w; }
