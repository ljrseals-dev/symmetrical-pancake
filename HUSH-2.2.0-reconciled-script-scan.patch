+void scan_urls(Ctx& c, const std::string& line, std::size_t ln) {
+  const std::string lo = lower(line);
+  for (std::size_t p = lo.find("://"); p != std::string::npos; p = lo.find("://", p + 3)) {
+    std::size_t s = p; while (s > 0 && std::isalpha(static_cast<unsigned char>(lo[s - 1]))) --s;
+    std::string scheme = lo.substr(s, p - s);
+    if (scheme != "http" && scheme != "https" && scheme != "ftp" && scheme != "ws" && scheme != "wss" && scheme != "tcp" && scheme != "udp" && scheme != "sftp") continue;
+    std::size_t h = p + 3, e = h;
+    while (e < lo.size() && !std::strchr("/?#\"' )]>,;\\", lo[e]) && !std::isspace(static_cast<unsigned char>(lo[e]))) ++e;
+    std::string host = lo.substr(h, e - h);
+    auto at = host.rfind('@'); if (at != std::string::npos) host = host.substr(at + 1);
+    if (!host.empty() && host[0] != '[') { auto col = host.find(':'); if (col != std::string::npos) host = host.substr(0, col); }
+    if (host.empty() || host.find('{') != std::string::npos || host.find('$') != std::string::npos || host.find('%') != std::string::npos) continue;
+    if (is_local_host(host) || host_allowed(host, c.opt.allow_hosts)) continue;
+    ++c.urls;
+    std::string url = clip(line.substr(s, std::min<std::size_t>(e - s + 40, 160)), 100);
+    if (ends_with(host, ".onion") || ends_with(host, ".i2p")) c.add("url-onion", "network", "call_home", "Tor/I2P address", S::High, ln, url, "anonymity-network endpoint", .85, .1);
+    else if (parse_ipv4(host)) c.add("url-ip-literal", "network", "call_home", "URL with an IP address", S::Medium, ln, url, "raw IP endpoints bypass DNS-based review; verify it is authorized", .6, .4);
+    else if (scheme == "http" || scheme == "ftp" || scheme == "ws") c.add("url-cleartext", "network", "call_home", "Cleartext URL to " + host, S::Medium, ln, url, "unencrypted network endpoint; verify it is authorized", .5, .5);
+    else c.add("url-host", "network", "call_home", "URL to " + host, S::Low, ln, url, "verify the host against the authorized endpoints", .4, .6);
+  }
+}
+void scan_generic(Ctx& c, const std::string& line, std::size_t ln) {
+  scan_urls(c, line, ln);
+  if (line.size() > 8 && line.size() < 4000) {
+    for (auto& f : fk::clipboard::scan_sensitive(line))
+      if (f.kind != "long opaque token-like string")
+        c.add("secret", "secret", "other", "possible secret: " + f.kind, S::Medium, ln, "[redacted]", "credentials in source can leak or act as a hard-coded backdoor credential", .6, .4);
+  }
+  std::size_t run = 0, best = 0; std::size_t hexrun = 0, hexbest = 0, xcount = 0;
+  for (std::size_t i = 0; i < line.size(); ++i) {
+    char ch = line[i];
+    run = b64ish(ch) ? run + 1 : 0; best = std::max(best, run);
+    hexrun = std::isxdigit(static_cast<unsigned char>(ch)) ? hexrun + 1 : 0; hexbest = std::max(hexbest, hexrun);
+    if (ch == '\\' && i + 1 < line.size() && (line[i + 1] == 'x' || line[i + 1] == 'u')) ++xcount;
+  }
+  const bool blob_ok = (c.lang & (RPP | CFG)) && (all_b64(trim(line)) || line.find('=') == std::string::npos);
+  if (best >= 120 && !(c.lang & RPP && all_b64(trim(line)))) { ++c.blobs; if (c.lang & RPP) {} else c.add("long-base64", "obfuscation", "backdoor", "long encoded blob", S::Medium, ln, "(" + std::to_string(best) + " base64-like characters)", "encoded payloads are a common way to hide code or data", .5, .5); }
+  else if (hexbest >= 96 && !blob_ok) c.add("long-hex", "obfuscation", "backdoor", "long hex string", S::Low, ln, "(" + std::to_string(hexbest) + " hex characters)", "may be an encoded payload (or a hash/key)", .3, .7);
+  if (xcount > 40) c.add("escape-heavy", "obfuscation", "backdoor", "heavy \\x / \\u escape sequences", S::Medium, ln, "(" + std::to_string(xcount) + " escapes)", "character escapes are used to hide strings", .5, .5);
+  if (line.size() > 5000 && !(c.lang & (RPP | CFG))) c.add("very-long-line", "obfuscation", "backdoor", "very long line (minified or obfuscated?)", S::Low, ln, "(" + std::to_string(line.size()) + " characters)", "hard to review", .3, .7);
+}
+void apply_rules(Ctx& c, const std::string& code, std::size_t ln, const std::string& full) {
+  const std::string lo = lower(code);
+  if (lo.empty()) return;
+  for (const auto& r : kRules) {
+    if (!(r.langs & c.lang)) continue;
+    const std::string needle = r.needle;
+    for (std::size_t p = lo.find(needle); p != std::string::npos; p = lo.find(needle, p + 1)) {
+      if (ident(needle[0]) && !(r.flags & NO_BOUNDARY)) {
+        if (p > 0 && ident(lo[p - 1])) continue;
+        if ((r.flags & NOT_AFTER_DOT) && p > 0 && lo[p - 1] == '.') continue;
+      }
+      c.add(r.id, r.topic, r.category, r.title, r.sev, ln, clip(full), r.why, r.conf, r.fp);
+      break;
+    }
+  }
+  // write-mode open()
+  for (std::size_t p = lo.find("open("); p != std::string::npos; p = lo.find("open(", p + 1)) {
+    if (p > 0 && (ident(lo[p - 1]) && lo[p - 1] != '.')) continue;
+    const bool lua_io = p >= 3 && lo.compare(p - 3, 3, "io.") == 0;
+    if (((c.lang & PY) && (p == 0 || lo[p - 1] != '.' ) ) || ((c.lang & LUA) && lua_io)) {
+      if (has_write_mode(code.substr(p))) { c.add("file-write-open", "file_write", "other", "file opened for writing", S::Medium, ln, clip(full), "writes files; check the destination and that the user asked for it", .5, .5); break; }
+    }
+  }
+  // persistent ExtState
+  std::size_t es = lo.find("setextstate(");
+  if (es != std::string::npos && (c.lang & LUALIKE)) {
+    std::string rest = lo.substr(es);
+    auto cp = rest.rfind(')'); if (cp != std::string::npos) rest = rest.substr(0, cp);
+    auto tp = rest.rfind("true");
+    if (tp != std::string::npos && rest.find_first_not_of(" \t", tp + 4) == std::string::npos)
+      c.add("reaper-extstate-persist", "persistence", "reascript_risk", "persistent ExtState write", S::Medium, ln, clip(full), "saved to disk and read back across sessions; can hold state or payloads", .5, .5);
+  }
+  // decode and execute markers (file-level combination)
+  static const char* dec[] = {"b64decode", "atob(", "fromhex(", "frombase64string", "base64 -d", "codecs.decode(", "zlib.decompress", "string.char("};
+  static const char* exe[] = {"exec(", "eval(", "loadstring(", "load(", "os.system(", "subprocess.", "invoke-expression", "iex ", "os.execute", "execprocess("};
+  for (auto d : dec) if (lo.find(d) != std::string::npos && !c.decode_line) c.decode_line = ln;
+  for (auto e : exe) { auto p = lo.find(e); if (p != std::string::npos && (p == 0 || !ident(lo[p - 1])) && !c.exec_line) c.exec_line = ln; }
+}
+void scan_rpp(Ctx& c, const std::string& line, std::size_t ln) {
+  std::string t = trim(line);
+  static const char* plug[] = {"<vst ", "<vst3 ", "<clap ", "<js ", "<au ", "<dx ", "<vst3i ", "<vsti "};
+  std::string lo = lower(t);
+  for (auto p : plug) if (lo.rfind(p, 0) == 0) { if (++c.plugin_refs <= 200) c.add("rpp-plugin", "inventory", "unauthorized_plugin", "project references a plugin", S::Info, ln, clip(t, 110), "inventory for the plugin allowlist; confirm each plugin is authorized", .5, .5); return; }
+  if (lo.rfind("file ", 0) == 0 || lo.rfind("filename ", 0) == 0) {
+    bool abs = t.find(" \"/") != std::string::npos || t.find(" /") != std::string::npos || (t.size() > 8 && t.find(":\\") != std::string::npos) || t.find("..") != std::string::npos;
+    if (abs && ++c.media_refs <= 100) c.add("rpp-external-path", "inventory", "other", "media or file path outside the project", S::Low, ln, clip(t, 110), "project depends on a file at an absolute or parent path", .4, .6);
+  }
+}
+void scan_kb(Ctx& c, const std::string& line, std::size_t ln) {
+  std::string t = trim(line);
+  if (t.rfind("SCR ", 0) == 0) c.add("kb-script", "persistence", "reascript_risk", "registered script action", S::Info, ln, clip(t, 140), "script registered as an action; confirm it is reviewed", .5, .5);
+  else if (t.rfind("ACT ", 0) == 0) c.add("kb-custom-action", "inventory", "reascript_risk", "custom action", S::Info, ln, clip(t, 140), "custom action; check what it runs", .4, .6);
+}
