+struct Ctx {
+  const Options& opt; std::string file; unsigned lang; Report& rep;
+  Ctx(const Options& o, std::string f, unsigned l, Report& r) : opt(o), file(std::move(f)), lang(l), rep(r) {}
+  std::size_t plugin_refs = 0, media_refs = 0, blobs = 0, urls = 0;
+  std::size_t decode_line = 0, exec_line = 0;
+  std::set<std::string> seen;   // dedupe rule+line
+  void add(const char* rule, const char* topic, const char* cat, const std::string& title, Severity sev, std::size_t line, const std::string& ev,
+           const std::string& why, double conf, double fp) {
+    std::string key = std::string(rule) + ":" + std::to_string(line) + ":" + ev;
+    if (!seen.insert(key).second) return;
+    Finding f; f.rule = rule; f.topic = topic; f.category = cat; f.title = title; f.severity = sev; f.file = file; f.line = line;
+    f.evidence = ev; f.why = why; f.confidence = conf; f.false_positive = fp; rep.findings.push_back(std::move(f));
+  }
+};
