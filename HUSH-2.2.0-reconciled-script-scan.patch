+std::string strip_nuls_for_utf16(const std::string& raw, bool& changed) {
+  changed = false;
+  if (raw.size() >= 2 && ((static_cast<unsigned char>(raw[0]) == 0xFF && static_cast<unsigned char>(raw[1]) == 0xFE) || (static_cast<unsigned char>(raw[0]) == 0xFE && static_cast<unsigned char>(raw[1]) == 0xFF))) {
+    std::string out; for (std::size_t i = 2; i < raw.size(); ++i) if (raw[i] != '\0') out.push_back(raw[i]);
+    changed = true; return out;
+  }
+  return raw;
+}
+std::string magic_kind(const std::string& raw) {
+  auto u = [&](std::size_t i) { return i < raw.size() ? static_cast<unsigned char>(raw[i]) : 0u; };
+  if (u(0) == 0x7F && u(1) == 'E' && u(2) == 'L' && u(3) == 'F') return "ELF executable/library";
+  if (u(0) == 'M' && u(1) == 'Z') return "Windows PE executable/DLL";
+  if ((u(0) == 0xCF && u(1) == 0xFA && u(2) == 0xED && u(3) == 0xFE) || (u(0) == 0xFE && u(1) == 0xED && u(2) == 0xFA) || (u(0) == 0xCA && u(1) == 0xFE && u(2) == 0xBA && u(3) == 0xBE)) return "Mach-O executable/library";
+  if (u(0) == 'P' && u(1) == 'K' && u(2) == 3 && u(3) == 4) return "ZIP archive";
+  if (u(0) == 0x1F && u(1) == 0x8B) return "gzip archive";
+  if (u(0) == '%' && u(1) == 'P' && u(2) == 'D' && u(3) == 'F') return "PDF document";
+  return "binary data";
+}
+void scan_content(Ctx& c, const std::string& text) {
+  LineState st; std::size_t ln = 0; std::size_t pos = 0;
+  std::string code, comment;
+  const unsigned lang = c.lang;
+  while (pos <= text.size()) {
+    std::size_t e = text.find('\n', pos);
+    std::string line = text.substr(pos, e == std::string::npos ? std::string::npos : e - pos);
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    ++ln; pos = (e == std::string::npos) ? text.size() + 1 : e + 1;
+    if (line.empty()) continue;
+    const std::string scan_line = line.size() > 20000 ? line.substr(0, 20000) : line;
+    if (lang & RPP) { scan_rpp(c, scan_line, ln); }
+    if (lang & KB) { scan_kb(c, scan_line, ln); }
+    if (lang & (RPP)) { std::string t = trim(scan_line); if (all_b64(t) && t.size() >= 40) { ++c.blobs; continue; } }
+    split_comment(scan_line, lang, st, code, comment);
+    if (lang & (CODE | KB)) apply_rules(c, code, ln, scan_line);
+    scan_generic(c, scan_line, ln);
+    if (lang & OTHER) apply_rules(c, scan_line, ln, scan_line);   // generic persistence rules apply to text/config too
+    else if (lang & CFG) apply_rules(c, code, ln, scan_line);
+  }
+  if (c.decode_line && c.exec_line)
+    c.add("decode-and-exec", "obfuscation", "backdoor", "decode-and-execute pattern", S::High, c.exec_line,
+          "(decoder on line " + std::to_string(c.decode_line) + ", execution on line " + std::to_string(c.exec_line) + ")",
+          "content is decoded and then executed: the classic way to hide a payload", .7, .3);
+  if (c.plugin_refs > 200) c.rep.limitations.push_back(c.file + ": " + std::to_string(c.plugin_refs) + " plugin references (first 200 listed)");
+  if (c.blobs && (lang & RPP)) c.add("rpp-state-blob", "inventory", "other", "embedded plugin state blobs", S::Info, 0, "(" + std::to_string(c.blobs) + " base64 lines)", "plugin state is stored as opaque base64; its contents are NOT analyzed", .8, .2);
+}
+void parse_baseline(const std::string& path, std::map<std::string, std::string>& out, std::string& err) {
+  std::ifstream f(path);
+  if (!f) { err = "cannot open baseline file: " + path; return; }
+  std::string line; std::size_t n = 0;
+  while (std::getline(f, line)) {
+    ++n; if (!line.empty() && line.back() == '\r') line.pop_back();
+    if (line.empty() || line[0] == '#') continue;
+    if (line.size() < 67 || line[64] != ' ') { err = "baseline line " + std::to_string(n) + " is not '<sha256>  <path>'"; return; }
+    for (int i = 0; i < 64; ++i) if (!std::isxdigit(static_cast<unsigned char>(line[static_cast<std::size_t>(i)]))) { err = "baseline line " + std::to_string(n) + ": bad hash"; return; }
+    std::string p = line.substr(65); if (!p.empty() && (p[0] == ' ' || p[0] == '*')) p = p.substr(1);
+    while (p.rfind("./", 0) == 0) p = p.substr(2);
+    out[p] = lower(line.substr(0, 64));
+  }
+}
