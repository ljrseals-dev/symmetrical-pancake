+std::string detect_language(const std::string& filename, const std::string& first_line) {
+  const std::string n = lower(fs::path(filename).filename().string());
+  const std::string ext = lower(fs::path(filename).extension().string());
+  if (n == "reaper-kb.ini") return "reaper-actions";
+  if (ext == ".rpp" || ext == ".rpp-bak" || ext == ".rpp-undo") return "reaper-project";
+  static const std::map<std::string, std::string> m = {{".py", "python"}, {".pyw", "python"}, {".pyi", "python"}, {".lua", "lua"}, {".eel", "eel"}, {".jsfx", "jsfx"},
+    {".sh", "shell"}, {".bash", "shell"}, {".zsh", "shell"}, {".ksh", "shell"}, {".bat", "batch"}, {".cmd", "batch"}, {".ps1", "powershell"}, {".psm1", "powershell"},
+    {".js", "javascript"}, {".mjs", "javascript"}, {".cjs", "javascript"}, {".ts", "javascript"}, {".c", "c/c++"}, {".h", "c/c++"}, {".cpp", "c/c++"}, {".hpp", "c/c++"},
+    {".cc", "c/c++"}, {".cxx", "c/c++"}, {".hxx", "c/c++"}, {".m", "c/c++"}, {".mm", "c/c++"}, {".ini", "config"}, {".cfg", "config"}, {".conf", "config"},
+    {".json", "config"}, {".yaml", "config"}, {".yml", "config"}, {".toml", "config"}, {".xml", "config"}, {".plist", "config"}, {".cmake", "config"},
+    {".txt", "text"}, {".md", "text"}, {".rst", "text"}};
+  auto it = m.find(ext); if (it != m.end()) return it->second;
+  if (n == "makefile" || n == "dockerfile") return "shell";
+  if (first_line.rfind("#!", 0) == 0) {
+    const std::string l = lower(first_line);
+    if (l.find("python") != std::string::npos) return "python";
+    if (l.find("lua") != std::string::npos) return "lua";
+    if (l.find("node") != std::string::npos) return "javascript";
+    if (l.find("pwsh") != std::string::npos || l.find("powershell") != std::string::npos) return "powershell";
+    if (l.find("sh") != std::string::npos) return "shell";
+  }
+  if (lower(first_line).rfind("desc:", 0) == 0) return "jsfx";
+  return "text";
+}
