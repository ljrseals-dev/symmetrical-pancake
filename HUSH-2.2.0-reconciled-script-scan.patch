+namespace {
+std::string jstr(const std::string& s) {
+  std::string o = "\"";
+  for (unsigned char c : s) {
+    switch (c) { case '"': o += "\\\""; break; case '\\': o += "\\\\"; break; case '\n': o += "\\n"; break; case '\r': o += "\\r"; break; case '\t': o += "\\t"; break;
+      default: if (c < 32) { char b[8]; std::snprintf(b, sizeof b, "\\u%04x", c); o += b; } else o.push_back(static_cast<char>(c)); }
+  }
+  return o + "\"";
+}
+std::vector<const Finding*> sorted(const Report& r) {
+  std::vector<const Finding*> v; for (auto& f : r.findings) v.push_back(&f);
+  std::stable_sort(v.begin(), v.end(), [](const Finding* a, const Finding* b) { if (a->severity != b->severity) return a->severity > b->severity; if (a->file != b->file) return a->file < b->file; return a->line < b->line; });
+  return v;
+}
