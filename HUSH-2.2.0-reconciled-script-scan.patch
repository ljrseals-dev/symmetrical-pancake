+Result<Report> scan_path(const fs::path& root, const Options& opt) {
+  using R = Result<Report>;
+  std::error_code ec;
+  const auto st = fs::symlink_status(root, ec);
+  if (ec) return R::fail("cannot access " + root.string());
+  if (fs::is_symlink(st)) return R::fail("refusing to scan through a symbolic link: " + root.string());
+  Report rep;
+  std::vector<fs::path> paths;
+  if (fs::is_regular_file(st)) paths.push_back(root);
+  else if (fs::is_directory(st)) {
+    fs::recursive_directory_iterator it(root, fs::directory_options::skip_permission_denied, ec), end;
+    if (ec) return R::fail("cannot read directory " + root.string());
+    for (; it != end; it.increment(ec)) {
+      if (ec) { ++rep.skipped; ec.clear(); continue; }
+      if (it->is_symlink(ec)) { ++rep.skipped; ec.clear(); continue; }
+      if (it.depth() >= opt.max_depth) { it.disable_recursion_pending(); }
+      if (!it->is_regular_file(ec)) continue;
+      if (paths.size() >= opt.max_files) { rep.limitations.push_back("file limit reached (" + std::to_string(opt.max_files) + "); remaining files were not scanned"); break; }
+      paths.push_back(it->path());
+    }
+    std::sort(paths.begin(), paths.end());
+  } else return R::fail("not a regular file or directory: " + root.string());
+
+  std::map<std::string, std::string> base; bool have_base = false;
+  if (!opt.baseline_path.empty()) {
+    std::string err; parse_baseline(opt.baseline_path, base, err);
+    if (!err.empty()) return R::fail(err);
+    have_base = true; rep.baseline.used = true;
+  }
+  const bool single = fs::is_regular_file(st);
+  std::set<std::string> seen_rel;
+  for (const auto& p : paths) {
+    std::string rel = single ? p.filename().generic_string() : fs::relative(p, root, ec).generic_string();
+    FileInfo fi; fi.path = rel;
+    auto size = fs::file_size(p, ec); fi.bytes = ec ? 0 : size; ec.clear();
+    auto h = fk::hash::sha256_file(p); fi.sha256 = h ? *h : "";
+    seen_rel.insert(rel);
+    if (have_base) {
+      auto b = base.find(rel);
+      if (b == base.end()) rep.baseline.new_files.push_back(rel);
+      else if (b->second != fi.sha256) rep.baseline.modified.push_back(rel);
+    }
+    if (fi.bytes > opt.max_file_bytes) { fi.language = "unknown"; fi.note = "larger than the scan limit: hashed, not scanned"; rep.files.push_back(fi); ++rep.skipped; continue; }
+    std::ifstream f(p, std::ios::binary);
+    if (!f) { fi.note = "cannot read: skipped"; rep.files.push_back(fi); ++rep.skipped; continue; }
+    std::string raw((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    bool changed = false; std::string text = strip_nuls_for_utf16(raw, changed);
+    const bool binary = text.substr(0, 8192).find('\0') != std::string::npos;
+    Ctx c{opt, rel, 0, rep};
+    if (binary) {
+      const std::string kind = magic_kind(raw);
+      fi.language = "binary: " + kind; fi.note = "hashed; contents not analyzed";
+      const std::string ext = lower(p.extension().string());
+      static const std::set<std::string> plug = {".dll", ".so", ".dylib", ".vst3", ".vst", ".clap", ".component", ".aaxplugin", ".node", ".exe"};
+      if (kind.find("executable") != std::string::npos || kind.find("DLL") != std::string::npos) {
+        if (plug.count(ext)) c.add("native-plugin-binary", "inventory", "unauthorized_plugin", "native code file: " + kind, S::Medium, 0, rel, "compiled code is not analyzed here; confirm it is on the plugin allowlist and verify its hash/signature", .6, .4);
+        else c.add("native-binary", "inventory", "other", "native code file: " + kind, S::Low, 0, rel, "compiled code is not analyzed here", .5, .5);
+      } else if (kind.find("archive") != std::string::npos)
+        c.add("archive-not-opened", "inventory", "other", "archive not opened: " + kind, S::Low, 0, rel, "contents were not inspected; extract it into an isolated folder and scan that", .5, .5);
+      rep.files.push_back(fi); continue;
+    }
+    const std::string first = text.substr(0, text.find('\n'));
+    fi.language = detect_language(rel, first); fi.scanned = true; c.lang = lang_bit(fi.language);
+    if (changed) fi.note = "UTF-16 detected; scanned as its ASCII subset";
+    if (lower(fs::path(rel).filename().string()).rfind("__startup.", 0) == 0)
+      c.add("reaper-startup-script", "persistence", "reascript_risk", "startup script", S::Medium, 0, rel, "name suggests it runs when REAPER starts (verify against your REAPER version)", .5, .5);
+    scan_content(c, text);
+    rep.files.push_back(fi);
+  }
+  if (have_base) for (auto& kv : base) if (!seen_rel.count(kv.first) && !single) rep.baseline.missing.push_back(kv.first);
+  if (have_base) {
+    for (auto& m : rep.baseline.modified) { Finding f; f.rule = "baseline-modified"; f.topic = "integrity"; f.category = "altered_code"; f.title = "file differs from baseline"; f.file = m; f.severity = Severity::High; f.evidence = "SHA-256 mismatch"; f.why = "the hash is certain; whether the change is malicious is not"; f.confidence = 0.95; f.false_positive = 0.05; rep.findings.push_back(f); }
+    for (auto& m : rep.baseline.new_files) { Finding f; f.rule = "baseline-new"; f.topic = "integrity"; f.category = "altered_code"; f.title = "file not in baseline"; f.file = m; f.severity = Severity::Medium; f.evidence = "new file"; f.why = "not part of the reviewed baseline"; f.confidence = 0.9; f.false_positive = 0.2; rep.findings.push_back(f); }
+    for (auto& m : rep.baseline.missing) { Finding f; f.rule = "baseline-missing"; f.topic = "integrity"; f.category = "altered_code"; f.title = "baseline file is missing"; f.file = m; f.severity = Severity::Medium; f.evidence = "missing"; f.why = "listed in the baseline but not found"; f.confidence = 0.9; f.false_positive = 0.2; rep.findings.push_back(f); }
+  }
+  for (const char* l : {"Pattern matching only: false positives and false negatives are expected, and deliberate obfuscation defeats it.",
+                        "Nothing was executed, imported, extracted or fetched; URLs were not contacted; symbolic links were skipped, not followed.",
+                        "Compiled binaries and archives are hashed and listed but their contents are not analyzed.",
+                        "Absence of findings is not evidence that a script is safe."})
+    rep.limitations.push_back(l);
+  return R::success(std::move(rep));
+}
