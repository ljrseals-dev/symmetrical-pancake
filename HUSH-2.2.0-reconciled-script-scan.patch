+Report scan_text(const std::string& name, const std::string& text, const Options& opt) {
+  Report rep;
+  std::string first = text.substr(0, text.find('\n'));
+  Ctx c{opt, name, lang_bit(detect_language(name, first)), rep};
+  FileInfo fi; fi.path = name; fi.language = detect_language(name, first); fi.bytes = text.size(); fi.scanned = true;
+  fi.sha256 = fk::hash::sha256_hex(reinterpret_cast<const unsigned char*>(text.data()), text.size());
+  rep.files.push_back(fi);
+  bool utf16 = false; std::string body = strip_nuls_for_utf16(text, utf16);
+  scan_content(c, body);
+  rep.limitations = {"Pattern matching only: false positives and false negatives are expected, and deliberate obfuscation defeats it.",
+                     "Nothing was executed, imported, extracted or fetched; URLs were not contacted."};
+  return rep;
+}
